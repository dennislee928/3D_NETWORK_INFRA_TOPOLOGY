# Backend (Rust SDN Adapter)
PORT=4000
RUST_LOG=info
SDN_TYPE=RYU              # RYU or ODL
RYU_URL=http://localhost:8080
ODL_URL=http://localhost:8181
ODL_USERNAME=admin
ODL_PASSWORD=admin
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_SDN_ADAPTER_URL=http://localhost:4000

# Docker / Mininet
SDN_ADAPTER_HOSTPORT=localhost:4000
AUTO_MININET=0
RYU_HOST=ryu
RYU_OF_PORT=6633
RYU_REST_PORT=8080
MININET_TOPO=tree,depth=5,fanout=5
